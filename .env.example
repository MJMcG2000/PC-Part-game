# Copy to .env (or set these as environment variables in Cloudflare Pages)
# and fill in your own values. While VITE_ADSENSE_CLIENT is unset or invalid,
# the site loads no ad code at all.

# Google AdSense publisher ID: "ca-pub-" followed by 16 digits.
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Ad unit ID for the single ad below the game (AdSense -> Ads -> By ad unit).
VITE_ADSENSE_SLOT=XXXXXXXXXX
